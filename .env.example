# ==========================================
# DIU CGPA Calculator - Environment Variables
# ==========================================

# 1. Supabase (Optional - uses local SQLite if omitted)
# Get these from your Supabase project settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-service-role-or-anon-key

# Secret mixed into stored password hashes (never stored in the DB). Generate once with
# `openssl rand -hex 32` and never change it (changing it just forces fresh logins).
PASSWORD_PEPPER=

# 2. Google OAuth Admin Authentication (required for /admin - admin is DISABLED if unset)
# Comma-separated list of Google emails allowed to access /admin
ADMIN_EMAILS=your.email@gmail.com,admin@diu.edu.bd

# Google OAuth Client ID (from Google Cloud Console -> Credentials)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# 3. Frontend origins allowed to call the backend (CORS), comma-separated
ALLOWED_ORIGINS=http://localhost:3000

# Remote Backend API URL (for Vercel deployment)
# Leave as http://localhost:8000 for local development
NEXT_PUBLIC_API_URL=http://localhost:8000

# 4. Scraper capacity (Optional - sensible defaults are derived from server RAM)
# Max logins running at once. Default: sized from RAM (~2 on a 1 GB VM, ~10 on 4 GB+).
# A new login also only starts if enough RAM is actually free at that moment.
# MAX_CONCURRENT_SCRAPES=2
# Pre-launched idle browsers ready for instant logins (~240 MB each).
# Default: 1 on <2 GB RAM, 2 on <4 GB, 3 above. Users beyond the spares wait ~7-10s for a launch.
# WARM_BROWSERS=2
# Browsers launched at the same time when spares run out. Default: CPU cores / 4 (min 1).
# LAUNCH_CONCURRENCY=1
# Abuse protection: logins per minute per visitor IP, and max length of the waiting line.
# LOGIN_RATE_LIMIT_PER_MIN=6
# MAX_QUEUE_WAITING=30
