# ==========================================
# DIU CGPA Calculator - Environment Variables
# ==========================================
# Copy to .env and fill in. Never commit the real .env: it holds secrets.

# 1. Supabase (Optional - uses local SQLite if omitted)
# Get these from your Supabase project settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-service-role-or-anon-key

# Secret mixed into stored password hashes (never stored in the DB). Generate once with
# `openssl rand -hex 32` and never change it (changing it just forces fresh logins).
PASSWORD_PEPPER=

# 2. Google OAuth Admin Authentication (required for /admin - admin is DISABLED if unset)
# Comma-separated list of Google emails allowed to access /admin
ADMIN_EMAILS=your.email@gmail.com,another.admin@example.com

# Google OAuth Client ID (from Google Cloud Console -> Credentials)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# 3. Frontend origins allowed to call the backend (CORS), comma-separated
ALLOWED_ORIGINS=http://localhost:3000

# Backend address(es) the site calls. For local development leave NEXT_PUBLIC_API_URL as is.
# With several backend servers set NEXT_PUBLIC_API_URLS (comma-separated, first = primary);
# the site then picks a free server per login and fails over if one is down.
NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_API_URLS=https://api.example.com,https://api2.example.com

# Frontend secrets for the admin sign-in (NextAuth). Set these in your hosting dashboard
# (e.g. Vercel -> Settings -> Environment Variables), never in a committed file.
# NEXTAUTH_URL=https://your-site.example.com
# NEXTAUTH_SECRET=
# GOOGLE_CLIENT_SECRET=

# 4. Backend server identity (Optional, useful with several servers)
# Name shown in the admin panel for this server (default: the machine's hostname)
# NODE_NAME=server-1
# When several servers are free, the site picks the lowest priority first (default 0)
# NODE_PRIORITY=0

# 5. Scraper capacity (Optional - sensible defaults are derived from server RAM)
# Max logins running at once. Default: (RAM - 350 MB) / 280 MB, between 1 and 10
# (1 on a 1 GB VM). A new login also only starts if enough RAM is actually free.
# MAX_CONCURRENT_SCRAPES=1
# Pre-launched idle browsers ready for instant logins (~240 MB each).
# Default: 0 below 1.5 GB RAM (an idle browser gets swapped out), 1 below 2 GB, 2 below 4 GB, 3 above.
# WARM_BROWSERS=0
# Browsers launched at the same time. Default: CPU cores / 4 (min 1).
# LAUNCH_CONCURRENCY=1

# 6. Limits (Optional)
# Logins per minute per visitor IP. Generous on purpose: a whole campus can share one IP.
# LOGIN_RATE_LIMIT_PER_MIN=60
# Login attempts per student ID per window (protects accounts from password guessing)
# STUDENT_ATTEMPT_LIMIT=10
# STUDENT_ATTEMPT_WINDOW_S=600
# Longest waiting line, and longest wait in it before "server busy"
# MAX_QUEUE_WAITING=30
# MAX_QUEUE_WAIT_SECONDS=300
